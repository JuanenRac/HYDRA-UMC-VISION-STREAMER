# One file per admin-configured camera slot (the same "cameraId" assigned
# in HYDRA-UMC-STUDIO's own admin panel), named by that slot's number:
#
#   sudo install -d /etc/hydra-umc/cameras
#   sudo cp cameras.env.example /etc/hydra-umc/cameras/1.env
#   sudo $EDITOR /etc/hydra-umc/cameras/1.env   # set DEVICE= for the real
#                                                # /dev/videoN this camera
#                                                # slot's cable is plugged
#                                                # into (see below)
#   sudo systemctl enable --now hydra-umc-vision-streamer@1
#
# Finding the right DEVICE=: a USB webcam usually exposes more than one
# /dev/videoN node on a modern kernel (a real capture node plus a metadata
# node) - `v4l2-ctl --list-devices` (package v4l-utils) lists them grouped
# by physical device so you can tell which node is the actual capture one
# for your camera model.
DEVICE=/dev/video0

# --width/--height/--fps are NOT set here - hydra_umc_vision_streamer's own
# `stream serve` CLI already defaults those to 1280x720x30 (see main.py);
# override only if this specific camera needs something else, by adding
# them to this unit's own ExecStart (systemctl edit
# hydra-umc-vision-streamer@N) rather than here, since systemd's
# EnvironmentFile has no way to inject extra ad-hoc argv flags.
